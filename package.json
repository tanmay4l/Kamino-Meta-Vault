{
  "license": "ISC",
  "scripts": {
    "build": "anchor build",
    "clean:test-ledger": "rm -rf test-ledger .anchor/test-ledger",
    "prepare:fixtures": "node tests/fixtures/generate-kamino-vault-fixtures.js",
    "test": "yarn clean:test-ledger && yarn prepare:fixtures && anchor test --validator legacy",
    "validate:local": "cargo fmt --check && cargo clippy --all-targets -- -D warnings && yarn lint && anchor build && npx tsc --noEmit && yarn clean:test-ledger && yarn prepare:fixtures && anchor test --validator legacy",
    "lint:fix": "prettier \"**/*.{js,ts,json,yml}\" --ignore-path .prettierignore --write",
    "lint": "prettier \"**/*.{js,ts,json,yml}\" --ignore-path .prettierignore --check"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.0.0",
    "@solana/spl-token": "^0.4.14"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "@types/node": "^22.0.0",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
